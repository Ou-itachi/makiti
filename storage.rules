rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Un compte authentifié n'est pas forcément admin. On vérifie le "badge
    // admin" (custom claim) présent dans le jeton d'authentification.
    //
    // Ce claim est posé/retiré automatiquement par la Cloud Function
    // `synchroniserBadgeAdmin` à chaque écriture dans la liste blanche
    // Firestore `admins/{uid}` — qui reste la source de vérité (là où on
    // ajoute/retire un admin). On NE fait PAS `firestore.exists(admins/...)`
    // ici : cet appel Firestore-depuis-Storage exige une permission IAM
    // supplémentaire non accordée par un `firebase deploy` en ligne de
    // commande, ce qui refusait silencieusement les uploads de vrais admins
    // (storage/unauthorized). Le claim, lui, est dans le jeton : fiable,
    // sans dépendance externe.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Photos produits : lecture publique (affichées sur le site), écriture
    // réservée à l'admin authentifié. Uniquement des images (pas de SVG,
    // qui peut contenir du script) et 20 Mo au plus : la photo est
    // normalement compressée avant l'envoi (produits.js), mais l'originale
    // part telle quelle si la compression échoue (ex. HEIC d'iPhone).
    match /produits/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && !request.resource.contentType.matches('image/svg.*');
      allow delete: if isAdmin();
    }

    // Les photos sont déposées par creerDemandeProduit après validation
    // serveur et limitation de fréquence; aucun upload anonyme direct.
    match /demandes-produits/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Photos « Endommagée », déposées par changerStatutCommande après
    // contrôle. Lecture : admin et livreur concerné (badge livreurId dans le
    // jeton, posé par lierCompteLivreur). Jamais d'écriture directe.
    match /incidents/{livreurId}/{commandeId}/{fichier} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.livreurId == livreurId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
