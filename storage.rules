rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Un compte authentifié n'est pas forcément admin. On vérifie le "badge
    // admin" (custom claim) présent dans le jeton d'authentification.
    //
    // Ce claim est posé/retiré automatiquement par la Cloud Function
    // `synchroniserBadgeAdmin` à chaque écriture dans la liste blanche
    // Firestore `admins/{uid}` — qui reste la source de vérité (là où on
    // ajoute/retire un admin). On NE fait PAS `firestore.exists(admins/...)`
    // ici : cet appel Firestore-depuis-Storage exige une permission IAM
    // supplémentaire non accordée par un `firebase deploy` en ligne de
    // commande, ce qui refusait silencieusement les uploads de vrais admins
    // (storage/unauthorized). Le claim, lui, est dans le jeton : fiable,
    // sans dépendance externe.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Photos produits : lecture publique (affichées sur le site), écriture
    // réservée à l'admin authentifié.
    match /produits/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Photos jointes aux demandes de produits hors catalogue : le client
    // peut en déposer à la création de sa demande (pas encore authentifié à
    // ce stade, donc création publique nécessaire), seul l'admin peut
    // ensuite consulter/gérer le dossier.
    //   - `create` seulement (pas update/delete) : personne ne peut écraser
    //     ni supprimer une photo déjà déposée par un autre.
    //   - 5 Mo max + type image : borne un dépôt de fichier arbitraire.
    // Le contentType est déclaré par le client (non vérifié contre le
    // contenu réel) : protection best-effort. Firebase App Check (voir
    // firebase-config.js) est la vraie barrière anti-automatisation.
    match /demandes-produits/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
