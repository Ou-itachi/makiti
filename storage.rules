rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Un compte authentifié n'est pas forcément admin. On vérifie le "badge
    // admin" (custom claim) présent dans le jeton d'authentification.
    //
    // Ce claim est posé/retiré automatiquement par la Cloud Function
    // `synchroniserBadgeAdmin` à chaque écriture dans la liste blanche
    // Firestore `admins/{uid}` — qui reste la source de vérité (là où on
    // ajoute/retire un admin). On NE fait PAS `firestore.exists(admins/...)`
    // ici : cet appel Firestore-depuis-Storage exige une permission IAM
    // supplémentaire non accordée par un `firebase deploy` en ligne de
    // commande, ce qui refusait silencieusement les uploads de vrais admins
    // (storage/unauthorized). Le claim, lui, est dans le jeton : fiable,
    // sans dépendance externe.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Photos produits : lecture publique (affichées sur le site), écriture
    // réservée à l'admin authentifié.
    match /produits/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Les photos sont déposées par creerDemandeProduit après validation
    // serveur et limitation de fréquence; aucun upload anonyme direct.
    match /demandes-produits/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
