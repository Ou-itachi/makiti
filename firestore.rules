rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un compte Firebase Auth authentifié n'est PAS forcément un admin —
    // n'importe qui peut créer un compte via l'API Identity Toolkit avec la
    // clé publique du projet. L'appartenance admin est vérifiée via une
    // liste blanche dédiée, jamais éditable par le client (voir plus bas),
    // seulement par la console Firebase / le SDK Admin.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Compte livreur actif de l'appelant : relu à chaque accès, pour qu'une
    // désactivation prenne effet immédiatement, jeton encore valide compris.
    function monCompte() {
      return get(/databases/$(database)/documents/comptesLivreurs/$(request.auth.uid)).data;
    }
    function isLivreur() {
      return request.auth != null
        && exists(/databases/$(database)/documents/comptesLivreurs/$(request.auth.uid))
        && monCompte().actif != false
        && monCompte().doitChangerMdp != true;
    }
    function monIdLivraison(livreurId) {
      return (isAdmin() && livreurId == "admin_" + request.auth.uid)
        || (isLivreur() && monCompte().livreurId == livreurId);
    }

    // Liste blanche des admins : un document par UID admin, contenu sans
    // importance (seule l'existence du document compte). Jamais lisible ni
    // modifiable par un client, quel qu'il soit — évite qu'un compte puisse
    // se déclarer admin lui-même.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Catalogue produits : visible publiquement, modifiable par l'admin uniquement.
    match /produits/{produitId} {
      allow read: if true;
      allow write: if isAdmin();

      // Variantes (prix de vente + options propres à chaque combinaison) :
      // même politique que le produit parent. Les règles Firestore ne sont
      // pas récursives, cette sous-collection a besoin de son propre match.
      match /variantes/{varianteId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Prix d'achat (coût réel payé au fournisseur) : jamais sur le
      // document produit/variante lui-même, lisible publiquement pour le
      // catalogue — combiné au prix de vente (déjà public), n'importe qui
      // pourrait sinon calculer la marge exacte de Bokki sur chaque
      // produit. Sous-collection distincte, réservée à l'admin.
      match /interne/{docId} {
        allow read, write: if isAdmin();
      }
    }

    // Comptes clients (refonte phase 6) : profil (clients) et code personnel
    // haché (codesClients). Tout passe par les fonctions identifierClient,
    // profilClient, mesCommandesClient et creerCommande (SDK Admin) : aucun
    // accès direct, même pour le titulaire du compte.
    match /clients/{uid} {
      allow read, write: if false;
    }
    // Favoris (brief §5.5) : liste propre à chaque compte, lue et modifiée
    // directement par son titulaire (cache hors ligne de Firestore).
    // Document = { ajouteLe } uniquement ; l'ID est celui du produit.
    match /clients/{uid}/favoris/{produitId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && produitId.size() <= 40
        && request.resource.data.keys().hasOnly(["ajouteLe"])
        && request.resource.data.ajouteLe == request.time;
    }
    match /codesClients/{telephone} {
      allow read, write: if false;
    }
    // Parrainage : index des codes (codesParrainage/{code} → uid du parrain)
    // et marqueur « ce numéro a déjà été parrainé » (parrainages/{téléphone}).
    // Écrits et lus uniquement par creerCommande, profilClient et
    // suiviParrainageCommande (SDK Admin). Le code, le crédit et le nombre de
    // filleuls d'un client vivent sur clients/{uid} (fermé ci-dessus) et ne
    // sortent que par profilClient, pour son seul titulaire. Les réglages
    // (parametres/parrainage) sont couverts par parametres/{parametreId}.
    match /codesParrainage/{code} {
      allow read, write: if false;
    }
    match /parrainages/{telephone} {
      allow read, write: if false;
    }
    // Connexion par passkey (Face ID / empreinte) : clés publiques
    // (passkeys/{credentialId} → uid, compteur…) et défis à usage unique
    // (webauthnChallenges/{id}, 5 min). Lus et écrits uniquement par les
    // fonctions *Passkey (SDK Admin), jamais par un navigateur.
    match /passkeys/{credentialId} {
      allow read, write: if false;
    }
    match /webauthnChallenges/{defiId} {
      allow read, write: if false;
    }

    // Commandes : la création passe exclusivement par la Cloud Function
    // `creerCommande` (SDK Admin, contourne ces règles) — c'est elle qui
    // génère le code de livraison côté serveur, jamais le client. Le suivi
    // client passe exclusivement par obtenirSuiviCommande, qui
    // vérifie le code de livraison et ne renvoie qu'une projection publique.
    // Ni lecture directe d'un document ni liste publique ne sont permises.
    match /commandes/{commandeId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      // Statut, attribution et historique : uniquement par les fonctions
      // changerStatutCommande, attribuerLivreur et validerCodeLivraison, qui
      // contrôlent les transitions et notent qui, quand et pourquoi.
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "statut", "livreurId", "attribueeLe", "attribueePar", "noteLivreur", "historique",
          "statutMajLe", "statutMajPar", "raisonStatut", "photoIncident", "dateLivraison", "codeLivraison",
          "livreurNom", "livreurPrenom", "livreurRole", "lanceeLe", "livreePar", "codeEssais", "codeBloque",
          "aVerifier", "jetonSuivi"
        ]);
      allow delete: if isAdmin();

      // État interne de comptabilisation fournisseur (prix d'achat exact,
      // donc la marge de Bokki sur cette commande précise) : jamais sur le
      // document commandes lui-même — une sous-collection distincte,
      // réservée à l'admin, uniquement écrite par le trigger
      // onCommandeStatutChange (SDK Admin, contourne ces règles de toute
      // façon). Aucun client, admin inclus, n'a besoin d'y écrire directement.
      match /interne/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Fournisseurs, paiements et livreurs : données financières sensibles,
    // réservées à l'admin authentifié. `montantDu` (solde couru dû au
    // fournisseur) est calculé exclusivement côté serveur — crédité par le
    // trigger `onCommandeStatutChange` quand une commande passe "livrée",
    // débité par `enregistrerPaiementFournisseur` (toutes deux via le SDK
    // Admin, qui contourne ces règles) — jamais par une écriture admin
    // directe, qui pourrait sinon désynchroniser le solde de son historique.
    match /fournisseurs/{fournisseurId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && (!("montantDu" in request.resource.data) || request.resource.data.montantDu == 0);
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["montantDu"]);
      allow delete: if isAdmin();
    }

    // La création passe exclusivement par la Cloud Function
    // `enregistrerPaiementFournisseur` (SDK Admin, contourne ces règles) —
    // c'est elle qui débite atomiquement `fournisseurs.montantDu` en même
    // temps qu'elle crée ce document, pour que le solde ne puisse jamais
    // diverger de l'historique des paiements.
    match /paiementsFournisseurs/{paiementId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Identité et activation : par les fonctions creerLivreur et
    // changerActivationLivreur, pour rester alignées sur le compte de connexion.
    match /livreurs/{livreurId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "actif", "compteUid", "compteEmail", "pieceIdentite"
        ]);
      allow delete: if isAdmin();
    }

    // Compte livreur : lien entre un compte de connexion et une fiche livreur.
    // Écrit uniquement par les fonctions (SDK Admin). Le titulaire le lit pour
    // savoir qui il est et si son compte reste actif.
    match /comptesLivreurs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }

    // Copie réduite d'une commande pour « Ma livraison » (sans code de
    // livraison ni donnée financière interne), écrite par synchroniserLivraison.
    // Celui qui livre ne lit que les siennes et n'a aucun accès à commandes/{id}.
    match /livraisons/{commandeId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }

    // Numéros utiles à celui qui livre (Bokki, secours).
    match /parametres/equipe {
      allow read: if isAdmin() || isLivreur();
      allow write: if isAdmin();
    }

    // Argent : courses gagnées et encaissées, journées, paiements. Écrits par
    // le serveur seul ; historique non modifiable, jamais par un navigateur.
    match /courses/{commandeId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }
    match /journees/{journeeId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }
    match /paiementsLivreurs/{paiementId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }

    // Position, vidéos, photos et alertes : lecture par les admins et par
    // leur auteur, écriture par les fonctions seulement.
    match /positions/{positionId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }
    match /enregistrements/{enregistrementId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }
    match /photosIncident/{photoId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }
    match /alertes/{alerteId} {
      allow read: if isAdmin() || monIdLivraison(resource.data.livreurId);
      allow write: if false;
    }

    // Journal d'activité des admins (section 10).
    match /journalActivite/{entreeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // État public minimal d'une commande, pour le suivi en temps réel : le
    // client reçoit l'identifiant secret après avoir prouvé son code. Lecture
    // d'un document connu seulement, jamais de liste.
    match /suiviDirect/{jeton} {
      allow get: if true;
      allow list, write: if false;
    }

    // Demandes de produits hors catalogue : la création passe par la fonction
    // creerDemandeProduit (SDK Admin), qui valide les champs et les images.
    match /demandesProduits/{demandeId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Zones de livraison (délai + frais premium par ville) : visibles
    // publiquement (utilisées sur le site client), modifiables par l'admin
    // uniquement.
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coordonnées publiques de la boutique (nom, téléphone, WhatsApp,
    // adresse, horaires) : affichées sur le site client (contact.html,
    // faq.html) — lecture publique, écriture admin uniquement. Aucune donnée
    // sensible ici, uniquement ce qui est déjà destiné à être affiché.
    match /parametres/boutique {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Réglages internes de fonctionnement (ex. parametres/livraison =
    // longueur du code de livraison, parametres/notifications = préférences
    // d'alerte) : jamais utiles au client, donc réservés à l'admin dans les
    // deux sens — lus côté serveur par les Cloud Functions concernées via le
    // SDK Admin, qui contourne ces règles.
    match /parametres/{parametreId} {
      allow read, write: if isAdmin();
    }

    // Avis clients : lecture publique (page témoignages), mais création
    // exclusivement via la Cloud Function `creerAvis` (SDK Admin, contourne
    // ces règles). Une règle "create" côté client ne peut valider que la
    // commande existe et est livrée — elle ne peut pas vérifier que
    // produit/nom correspondent réellement à cette commande, ni empêcher
    // plusieurs avis pour la même commande, ni valider le type/la plage de
    // la note. La Cloud Function fait ces trois vérifications côté serveur
    // et n'écrit jamais commandeId dans le document public. C'est une défense
    // supplémentaire; les documents de commande ne sont pas lisibles par les
    // clients, même lorsqu'ils connaissent leur identifiant.
    // Modération réservée à l'admin.
    match /avis/{avisId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Codes de livraison actuellement réservés (codesActifs/{code}) : l'ID
    // du document EST le code de livraison. Jamais lisible ni modifiable par
    // un client, sinon lister la collection donnerait tous les codes actifs
    // et permettrait de valider une livraison à la place du client. Géré
    // uniquement par creerCommande (réservation) et libererCodeLivraison
    // (suppression), toutes deux via le SDK Admin.
    match /codesActifs/{code} {
      allow read, write: if false;
    }

    // Statistiques anonymes du jour (fonction collecte) : compteurs sans
    // donnée personnelle, lus par la page admin « Statistiques ».
    match /statistiques/{jour} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
