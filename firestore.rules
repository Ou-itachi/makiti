rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un compte Firebase Auth authentifié n'est PAS forcément un admin —
    // n'importe qui peut créer un compte via l'API Identity Toolkit avec la
    // clé publique du projet. L'appartenance admin est vérifiée via une
    // liste blanche dédiée, jamais éditable par le client (voir plus bas),
    // seulement par la console Firebase / le SDK Admin.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Liste blanche des admins : un document par UID admin, contenu sans
    // importance (seule l'existence du document compte). Jamais lisible ni
    // modifiable par un client, quel qu'il soit — évite qu'un compte puisse
    // se déclarer admin lui-même.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Catalogue produits : visible publiquement, modifiable par l'admin uniquement.
    match /produits/{produitId} {
      allow read: if true;
      allow write: if isAdmin();

      // Variantes (prix + stock propres à chaque combinaison d'options) :
      // même politique que le produit parent. Les règles Firestore ne sont
      // pas récursives, cette sous-collection a besoin de son propre match.
      match /variantes/{varianteId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Commandes : la création passe exclusivement par la Cloud Function
    // `creerCommande` (SDK Admin, contourne ces règles) — c'est elle qui
    // génère le code de livraison côté serveur, jamais le client. Un client
    // peut ensuite consulter UNE commande précise (page de suivi) s'il a son
    // numéro. Aucune liste publique de la collection n'est autorisée (le code
    // de livraison ne doit jamais être exposé par une requête "list"/"query").
    match /commandes/{commandeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Fournisseurs, paiements et livreurs : données financières sensibles,
    // réservées à l'admin authentifié.
    match /fournisseurs/{fournisseurId} {
      allow read, write: if isAdmin();
    }

    match /paiementsFournisseurs/{paiementId} {
      allow read, write: if isAdmin();
    }

    match /livreurs/{livreurId} {
      allow read, write: if isAdmin();
    }

    // Demandes de produits hors catalogue : un client peut soumettre une
    // demande, seul l'admin peut les consulter et les traiter.
    match /demandesProduits/{demandeId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Zones de livraison (délai + frais premium par ville) : visibles
    // publiquement (utilisées sur le site client), modifiables par l'admin
    // uniquement.
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avis clients : lecture publique (page témoignages), mais création
    // exclusivement via la Cloud Function `creerAvis` (SDK Admin, contourne
    // ces règles). Une règle "create" côté client ne peut valider que la
    // commande existe et est livrée — elle ne peut pas vérifier que
    // produit/nom correspondent réellement à cette commande, ni empêcher
    // plusieurs avis pour la même commande, ni valider le type/la plage de
    // la note. La Cloud Function fait ces trois vérifications côté serveur
    // et n'écrit jamais commandeId dans le document public (qui donnerait,
    // via une simple liste de la collection, un accès à l'ID de commande —
    // donc au nom/téléphone/adresse du client via `commandes.get`, public).
    // Modération réservée à l'admin.
    match /avis/{avisId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
