rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Catalogue produits : visible publiquement, modifiable par l'admin uniquement.
    match /produits/{produitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Commandes : la création passe exclusivement par la Cloud Function
    // `creerCommande` (SDK Admin, contourne ces règles) — c'est elle qui
    // génère le code de livraison côté serveur, jamais le client. Un client
    // peut ensuite consulter UNE commande précise (page de suivi) s'il a son
    // numéro. Aucune liste publique de la collection n'est autorisée (le code
    // de livraison ne doit jamais être exposé par une requête "list"/"query").
    match /commandes/{commandeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Fournisseurs, paiements et livreurs : données financières sensibles,
    // réservées à l'admin authentifié.
    match /fournisseurs/{fournisseurId} {
      allow read, write: if isAdmin();
    }

    match /paiementsFournisseurs/{paiementId} {
      allow read, write: if isAdmin();
    }

    match /livreurs/{livreurId} {
      allow read, write: if isAdmin();
    }

    // Demandes de produits hors catalogue : un client peut soumettre une
    // demande, seul l'admin peut les consulter et les traiter.
    match /demandesProduits/{demandeId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Zones de livraison (délai + frais premium par ville) : visibles
    // publiquement (utilisées sur le site client), modifiables par l'admin
    // uniquement.
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avis clients : lecture publique (page témoignages), mais un avis ne
    // peut être créé que pour une commande réellement livrée (empêche les
    // faux avis non liés à une vraie commande). Modération réservée à
    // l'admin.
    match /avis/{avisId} {
      allow read: if true;
      allow create: if request.resource.data.commandeId is string
        && get(/databases/$(database)/documents/commandes/$(request.resource.data.commandeId)).data.statut == 'livree';
      allow update, delete: if isAdmin();
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
